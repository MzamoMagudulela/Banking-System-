# SmartBank Environment Configuration Example
# Copy this file to .env and adjust variables as required

DJANGO_SECRET_KEY=smartbank-dev-insecure-secret-key-for-local-demo-only-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database:
# Leave blank for default portable SQLite (db.sqlite3)
# Or set for PostgreSQL: postgres://smartbank_user:smartbank_pass@localhost:5432/smartbank_db
DATABASE_URL=

# Default Currency
SMARTBANK_DEFAULT_CURRENCY=ZAR

# Fraud Watch Thresholds
SMARTBANK_FRAUD_HIGH_AMOUNT_THRESHOLD=25000.00
SMARTBANK_RAPID_TRANSACTION_COUNT=4
SMARTBANK_RAPID_TRANSACTION_MINUTES=5
